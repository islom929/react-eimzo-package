{
  "name": "@islom929/react-eimzo",
  "version": "0.4.4",
  "description": "React hook for E-IMZO digital signatures. Simple API, zero UI dependencies.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/embed-sdk.js && tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "~5.6.2"
  },
  "keywords": [
    "eimzo",
    "e-imzo",
    "e-imzo-react",
    "digital-signature",
    "electronic-signature",
    "pkcs7",
    "react",
    "react-hook",
    "uzbekistan",
    "eri",
    "capiws",
    "imzo"
  ],
  "license": "MIT",
  "homepage": "https://github.com/islom929/react-eimzo-package#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islom929/react-eimzo-package.git"
  },
  "bugs": {
    "url": "https://github.com/islom929/react-eimzo-package/issues"
  },
  "author": "islom929"
}
